# Secretos y configuración local.
# MediTriage maneja datos de salud (Ley 19.628 y Ley 21.719): nada de esto se sube.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json

# Datos clínicos: nunca versionar datos reales de pacientes.
/data/
*.csv
*.xlsx
!docs/**/*.csv

# Editores y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
*.swp

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Terraform: estado, caché y variables privadas
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Configuración privada del backend
*.tfbackend